# ==============================================================================
# CONFIGURACIÓN DEL BACKEND (DJANGO / REST FRAMEWORK)
# ==============================================================================
# Clave secreta de Django. OBLIGATORIA: el servidor no arranca sin ella (salvo DEBUG=True).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Modo Debug (False en producción)
DEBUG=False

# Hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,asistenciabodegon.onrender.com

# Cadena de conexión a base de datos PostgreSQL (Render / Supabase Pooler)
DATABASE_URL=postgresql://usuario:contraseña@servidor.com:5432/postgres

# Clave maestra para descargar el respaldo de datos. OBLIGATORIA (salvo DEBUG=True).
BACKUP_ADMIN_KEY=

# PIN de autorización para desembolsos y aprobación de horas extra en servidor
ADMIN_PAYROLL_PIN=2322
ADMIN_SUPERVISOR_PIN=4512

# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND (NEXT.JS)
# ==============================================================================
# URL base de la API Django
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Credenciales de Supabase (Sincronización en tiempo real y almacenamiento)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key-aqui

# PINs de acceso para interfaz de usuario Kiosco y Nómina
NEXT_PUBLIC_SUPERVISOR_PIN=4512
NEXT_PUBLIC_PAYROLL_PIN=2322
